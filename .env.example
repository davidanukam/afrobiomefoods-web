# Sanity: create a project at https://www.sanity.io/manage then fill these in
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Editor token (Editor permission) for npm run seed
SANITY_API_WRITE_TOKEN=

# Shared secret for /api/revalidate webhook (any long random string)
SANITY_REVALIDATE_SECRET=
